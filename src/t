use rand::Rng;
use crate::loss::mse;
use serde::{Serialize, Deserialize};
use rand::seq::SliceRandom;

pub struct MLP {
    pub weights: Vec<Vec<Vec<f64>>>, // weights[layer][neuron][input]
    pub biases: Vec<Vec<f64>>,       // biases[layer][neuron]
    pub weights_output: Vec<f64>,
    pub bias_output: f64,
    pub learning_rate: f64,
    pub epochs: usize,
    pub is_regression: bool,
    pub use_activation: bool,
}



fn softmax(logits: &[f64]) -> Vec<f64> {
    let max = logits.iter().cloned().fold(f64::NEG_INFINITY, f64::max);
    let exps: Vec<f64> = logits.iter().map(|&x| (x - max).exp()).collect();
    let sum: f64 = exps.iter().sum();
    exps.iter().map(|e| e / sum).collect()
}

#[derive(Serialize, Deserialize)]
pub struct MLPClassifier {
    pub weights: Vec<Vec<Vec<f64>>>,     // toutes les couches cachées
    pub biases: Vec<Vec<f64>>,
    pub weights_output: Vec<Vec<f64>>,   // couche de sortie (
    pub bias_output: Vec<f64>,
    pub learning_rate: f64,
    pub epochs: usize,
    pub n_classes: usize,
    pub loss_per_epoch: Vec<f32>,
}

impl MLP {
    pub fn new(
        n_inputs: usize,
        hidden_layers: &[usize],
        learning_rate: f64,
        epochs: usize,
        is_regression: bool,
        use_activation: bool,
    ) -> Self {
        let mut rng = rand::thread_rng();
        let mut weights = Vec::new();
        let mut biases = Vec::new();

        let mut input_size = n_inputs;
        for &layer_size in hidden_layers {
            let layer_weights = (0..layer_size)
                .map(|_| (0..input_size).map(|_| rng.gen_range(-1.0..1.0)).collect())
                .collect();
            let layer_biases = (0..layer_size).map(|_| rng.gen_range(-1.0..1.0)).collect();
            weights.push(layer_weights);
            biases.push(layer_biases);
            input_size = qlayer_size;
        }

        let weights_output = (0..input_size).map(|_| rng.gen_range(-1.0..1.0)).collect();
        let bias_output = rng.gen_range(-1.0..1.0);

        Self {
            weights,
            biases,
            weights_output,
            bias_output,
            learning_rate,
            epochs,
            is_regression,
            use_activation,
        }
    }

    fn activate(&self, x: f64) -> f64 {
        if self.use_activation {
            x.tanh()
        } else {
            x
        }
    }

    fn activate_derivative(&self, x: f64) -> f64 {
        if self.use_activation {
            1.0 - x.tanh().powi(2)
        } else {
            1.0
        }
    }

    fn forward(&self, input: &Vec<f64>) -> (Vec<Vec<f64>>, Vec<Vec<f64>>) {
        let mut activations = input.clone();
        let mut all_inputs = Vec::new();  // z
        let mut all_outputs = Vec::new(); // a

        for (w, b) in self.weights.iter().zip(self.biases.iter()) {
            let z: Vec<f64> = w.iter()
                .zip(b.iter())
                .map(|(neuron_w, &bias)| {
                    neuron_w.iter().zip(&activations).map(|(w_i, x_i)| w_i * x_i).sum::<f64>() + bias
                })
                .collect();

            let a: Vec<f64> = z.iter().map(|&v| self.activate(v)).collect();
            all_inputs.push(z);
            all_outputs.push(a.clone());
            activations = a;
        }

        (all_inputs, all_outputs)
    }

    pub fn predict(&self, x: &Vec<f64>) -> f64 {
        let (_, all_outputs) = self.forward(x);
        let last_output = &all_outputs.last().unwrap_or(x);
        let output_input: f64 = last_output.iter()
            .zip(&self.weights_output)
            .map(|(h, w)| h * w)
            .sum::<f64>() + self.bias_output;

        if self.is_regression {
            output_input
        } else {
            self.activate(output_input)
        }
    }

    pub fn fit(&mut self, X: &Vec<Vec<f64>>, y: &Vec<f64>) {
        for _ in 0..self.epochs {
            for (xi, &yi) in X.iter().zip(y.iter()) {
                let (zs, activations) = self.forward(xi);

                let output_input: f64 = activations.last().unwrap().iter()
                    .zip(&self.weights_output)
                    .map(|(h, w)| h * w)
                    .sum::<f64>() + self.bias_output;

                let output = if self.is_regression {
                    output_input
                } else {
                    self.activate(output_input)
                };

                let error = output - yi;
                let delta_output = if self.is_regression {
                    error
                } else {
                    error * self.activate_derivative(output_input)
                };

                // Mise à jour de la couche de sortie
                for i in 0..self.weights_output.len() {
                    self.weights_output[i] -= self.learning_rate * delta_output * activations.last().unwrap()[i];
                }
                self.bias_output -= self.learning_rate * delta_output;

                // Backpropagation des couches cachées
                let mut delta = (0..activations.last().unwrap().len())
                    .map(|j| {
                        delta_output * self.weights_output[j] * self.activate_derivative(zs.last().unwrap()[j])
                    })
                    .collect::<Vec<f64>>();

                for l in (0..self.weights.len()).rev() {
                    let a_prev = if l == 0 { xi } else { &activations[l - 1] };
                    for j in 0..self.weights[l].len() {
                        for k in 0..self.weights[l][j].len() {
                            self.weights[l][j][k] -= self.learning_rate * delta[j] * a_prev[k];
                        }
                        self.biases[l][j] -= self.learning_rate * delta[j];
                    }

                    // Préparer le delta pour la couche précédente (si ce n’est pas la première)
                    if l > 0 {
                        let mut new_delta = vec![0.0; self.weights[l][0].len()];
                        for k in 0..new_delta.len() {
                            for j in 0..delta.len() {
                                new_delta[k] += delta[j] * self.weights[l][j][k];
                            }
                            new_delta[k] *= self.activate_derivative(zs[l - 1][k]);
                        }
                        delta = new_delta;
                    }
                }
            }
        }
    }
}
impl MLPClassifier {
    pub fn new(n_inputs: usize, hidden_layers: &[usize], n_classes: usize, learning_rate: f64, epochs: usize) -> Self {
        let mut rng = rand::thread_rng();
        let mut weights = Vec::new();
        let mut biases = Vec::new();

        let mut input_size = n_inputs;
        for &layer_size in hidden_layers {
            let w = (0..layer_size)
                .map(|_| (0..input_size).map(|_| rng.gen_range(-0.1..0.1)).collect())
                .collect();
            let b = (0..layer_size).map(|_| rng.gen_range(-0.1..0.1)).collect();
            weights.push(w);
            biases.push(b);
            input_size = layer_size;
        }

        let weights_output = (0..n_classes)
            .map(|_| (0..input_size).map(|_| rng.gen_range(-0.1..0.1)).collect())
            .collect();
        let bias_output = (0..n_classes).map(|_| rng.gen_range(-0.1..0.1)).collect();

        Self {
            weights,
            biases,
            weights_output,
            bias_output,
            learning_rate,
            epochs,
            n_classes,
            loss_per_epoch: Vec::new(),
        }
    }

    fn activate(x: f64) -> f64 {
        x.tanh()
    }

    fn activate_derivative(x: f64) -> f64 {
        1.0 - x.tanh().powi(2)
    }

    fn forward(&self, input: &Vec<f64>) -> (Vec<Vec<f64>>, Vec<Vec<f64>>) {
        let mut activations = input.clone();
        let mut all_inputs = Vec::new();  // z
        let mut all_outputs = Vec::new(); // a

        for (w, b) in self.weights.iter().zip(self.biases.iter()) {
            let z: Vec<f64> = w.iter()
                .zip(b.iter())
                .map(|(neuron_w, &bias)| {
                    neuron_w.iter().zip(&activations).map(|(w_i, x_i)| w_i * x_i).sum::<f64>() + bias
                })
                .collect();
            let a: Vec<f64> = z.iter().map(|&v| Self::activate(v)).collect();
            all_inputs.push(z);
            all_outputs.push(a.clone());
            activations = a;
        }

        (all_inputs, all_outputs)
    }

    pub fn predict(&self, x: &Vec<f64>) -> usize {
        let (_, all_outputs) = self.forward(x);
        let last_output = all_outputs.last().unwrap();

        let logits: Vec<f64> = self.weights_output.iter()
            .zip(self.bias_output.iter())
            .map(|(w_out, &b)| last_output.iter().zip(w_out.iter()).map(|(h, w)| h * w).sum::<f64>() + b)
            .collect();

        let probs = softmax(&logits);
        probs.iter()
            .enumerate()
            .max_by(|a, b| a.1.partial_cmp(b.1).unwrap())
            .map(|(idx, _)| idx)
            .unwrap_or(0)
    }

    pub fn fit(&mut self, X: &Vec<Vec<f64>>, y: &Vec<usize>) {
        self.loss_per_epoch.clear();
        let mut rng = rand::thread_rng();
        let mut data: Vec<(&Vec<f64>, usize)> = X.iter().zip(y.iter().copied()).collect();

        for _ in 0..self.epochs {
            data.shuffle(&mut rng);

            for (xi, yi) in data.iter() {
                let (zs, activations) = self.forward(xi);
                let last_output = activations.last().unwrap();

                let logits: Vec<f64> = self.weights_output.iter()
                    .zip(self.bias_output.iter())
                    .map(|(w_out, &b)| last_output.iter().zip(w_out.iter()).map(|(h, w)| h * w).sum::<f64>() + b)
                    .collect();

                let probs = softmax(&logits);

                let mut delta_output = vec![0.0; self.n_classes];
                for j in 0..self.n_classes {
                    delta_output[j] = probs[j] - if j == *yi { 1.0 } else { 0.0 };
                }

                for j in 0..self.n_classes {
                    for k in 0..self.weights_output[j].len() {
                        self.weights_output[j][k] -= self.learning_rate * delta_output[j] * last_output[k];
                    }
                    self.bias_output[j] -= self.learning_rate * delta_output[j];
                }

                let mut delta = vec![0.0; last_output.len()];
                for k in 0..delta.len() {
                    for j in 0..self.n_classes {
                        delta[k] += delta_output[j] * self.weights_output[j][k];
                    }
                    delta[k] *= Self::activate_derivative(zs.last().unwrap()[k]);
                }

                for l in (0..self.weights.len()).rev() {
                    let a_prev = if l == 0 { xi } else { &activations[l - 1] };

                    for j in 0..self.weights[l].len() {
                        for i in 0..self.weights[l][j].len() {
                            self.weights[l][j][i] -= self.learning_rate * delta[j] * a_prev[i];
                        }
                        self.biases[l][j] -= self.learning_rate * delta[j];
                    }

                    if l > 0 {
                        let mut new_delta = vec![0.0; self.weights[l][0].len()];
                        for i in 0..new_delta.len() {
                            for j in 0..delta.len() {
                                new_delta[i] += delta[j] * self.weights[l][j][i];
                            }
                            new_delta[i] *= Self::activate_derivative(zs[l - 1][i]);
                        }
                        delta = new_delta;
                    }
                }
            }

            if let Some(mse_value) = self.evaluate_mse(X, y) {
                self.loss_per_epoch.push(mse_value);
            }
        }
    }

    pub fn evaluate_mse(&self, X: &Vec<Vec<f64>>, y: &Vec<usize>) -> Option<f32> {
        let mut predicted: Vec<f32> = Vec::new();
        let mut expected: Vec<f32> = Vec::new();

        for (xi, &yi) in X.iter().zip(y.iter()) {
            let (_, activations) = self.forward(xi);
            let last_output = activations.last().unwrap();

            let logits: Vec<f64> = self.weights_output.iter()
                .zip(self.bias_output.iter())
                .map(|(w_out, &b)| last_output.iter().zip(w_out.iter()).map(|(h, w)| h * w).sum::<f64>() + b)
                .collect();

            let probs = softmax(&logits);
            predicted.extend(probs.iter().map(|&p| p as f32));

            let mut one_hot = vec![0.0f32; self.n_classes];
            one_hot[yi] = 1.0;
            expected.extend(one_hot);
        }

        mse(&predicted, &expected)
    }

    pub fn evaluate_accuracy(&self, X: &Vec<Vec<f64>>, y: &Vec<usize>) -> f32 {
        let mut correct = 0;
        for (xi, &yi) in X.iter().zip(y.iter()) {
            if self.predict(xi) == yi {
                correct += 1;
            }
        }
        correct as f32 / y.len() as f32
    }
}
